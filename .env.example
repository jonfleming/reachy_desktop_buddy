# Optional realtime input transcription language.
# Defaults to "en". Set to a backend-supported code such as "zh" for Chinese.
# REALTIME_TRANSCRIPTION_LANGUAGE="en"

# Hugging Face connection mode: "deployed" or "local".
# Deployed mode uses the built-in Hugging Face server.
# Defaults to "deployed" when unset.
# HF_REALTIME_CONNECTION_MODE="deployed"

# Direct Hugging Face realtime endpoint for local/LAN backends.
# Accepts either the base URL (`ws://127.0.0.1:8765/v1`) or the full realtime URL
# (`ws://127.0.0.1:8765/v1/realtime`). Used when HF_REALTIME_CONNECTION_MODE=local.
# HF_REALTIME_WS_URL="ws://127.0.0.1:8765/v1/realtime"

# Hugging Face token for accessing datasets/models
HF_TOKEN=

# Optional built-in profile selector. Use a folder name from profiles/.
# If unset, the app uses the default profile unless startup settings were saved from the UI.
# REACHY_MINI_CUSTOM_PROFILE=mars_rover

# Optional external profile/tool directories
# REACHY_MINI_EXTERNAL_PROFILES_DIRECTORY=external_content/external_profiles
# REACHY_MINI_EXTERNAL_TOOLS_DIRECTORY=external_content/external_tools

# Optional: discover and auto-load all tools found in REACHY_MINI_EXTERNAL_TOOLS_DIRECTORY,
# even if they are not enabled by the selected profile or its Tool access override.
# This is convenient for downloaded tools used with built-in/default profiles.
# AUTOLOAD_EXTERNAL_TOOLS=1

# Minutes of inactivity before Reachy goes to sleep and the app stops. Default 1440 (one day), 0 disables.
# REACHY_MINI_APP_TIMEOUT_MINUTES=1440

# Hindsight memory server for the desktop buddy (long-term per-personality memory).
# BUDDY_HINDSIGHT_URL="http://localhost:8888"

# Bank naming: each personality gets its own bank "<prefix>-<personality>".
# BUDDY_HINDSIGHT_BANK_PREFIX="reachy"

# Where memories spool locally while the Hindsight server is unreachable.
# BUDDY_MEMORY_SPOOL_DIR="~/.reachy_buddy/memory_spool"

# Enable the desktop-buddy sidecar (idle gaze, face presence, greet/farewell, Hindsight).
# BUDDY_ENABLED=1

# Optional llama.cpp OpenAI-compatible origin for private thoughts (template fallback if unset/down).
# BUDDY_LLAMA_URL="http://localhost:8080/v1"
# BUDDY_LLAMA_MODEL="local"

# Persisted face encodings for person recognition.
# BUDDY_FACES_PATH="~/.reachy_buddy/faces.npz"

# YOLO-style ONNX object detector (disabled until both files exist).
# BUDDY_OBJECT_ONNX="C:/Models/yolo.onnx"
# BUDDY_OBJECT_LABELS="C:/Models/yolo.names"

# Optional local Google Calendar and Gmail tools. Install with: uv sync --extra google
# Create a Desktop OAuth client, enable the Gmail API and Google Calendar API, and add
# your account as a test user while the app is unverified. Do not commit these values.
# GOOGLE_OAUTH_CLIENT_ID=
# GOOGLE_OAUTH_CLIENT_SECRET=
# Or point at the downloaded Desktop client JSON instead of the two variables above.
# Keep that file outside the repository (client_secret*.json is gitignored if it is inside).
# GOOGLE_OAUTH_CLIENT_SECRET_FILE=

# Optional local screen-presence fingerprints (stuck-on-screen). Default OFF.
# Captures stay in memory, are downscaled to a hash, then discarded. No OCR,
# no raw frames on disk, and no images sent to Hindsight or the cloud.
# BUDDY_SCREEN_PRESENCE=0
# BUDDY_SCREEN_INTERVAL_SEC=20
# BUDDY_SCREEN_STUCK_MIN=12
# BUDDY_SCREEN_COOLDOWN_MIN=30
# BUDDY_SCREEN_SIMILARITY=0.92
# BUDDY_SCREEN_INDICATOR=1
# BUDDY_SCREEN_DEBUG_SAVE=0
